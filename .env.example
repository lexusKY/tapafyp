# Flask secret key
# Replace this with a long random string in your real .env file.
SECRET_KEY=replace-with-your-secret-key

# MySQL database connection
# Example for WAMP/MySQL with root user and no password:
DATABASE_URL=mysql+pymysql://root:@localhost:3306/tapa_db

# Alternative if localhost does not work:
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/tapa_db

# Gemini API key
# Do not commit your real API key.
GEMINI_API_KEY=replace-with-your-gemini-api-key